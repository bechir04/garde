generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OFFICER
  ANALYST
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique @db.VarChar(100)
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name") @db.VarChar(200)
  role         UserRole   @default(OFFICER)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  accidents    Accident[]
  importJobs   ImportJob[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Governorate {
  id     Int     @id @default(autoincrement())
  nameAr String  @map("name_ar") @db.VarChar(100)
  code   String  @db.VarChar(10)

  cities    City[]
  accidents Accident[]

  @@map("governorates")
}

model City {
  id            Int         @id @default(autoincrement())
  nameAr        String      @map("name_ar") @db.VarChar(150)
  governorateId Int         @map("governorate_id")
  governorate   Governorate @relation(fields: [governorateId], references: [id])

  accidents Accident[]

  @@map("cities")
}

model AccidentCause {
  id     Int    @id @default(autoincrement())
  nameAr String @map("name_ar") @db.VarChar(200)
  code   String @db.VarChar(50)

  accidents Accident[]

  @@map("accident_causes")
}

model VehicleBrand {
  id     Int     @id @default(autoincrement())
  nameAr String  @map("name_ar") @db.VarChar(100)
  nameEn String  @map("name_en") @db.VarChar(100)

  accidentsAsBrand1 Accident[] @relation("Brand1")
  accidentsAsBrand2 Accident[] @relation("Brand2")

  @@map("vehicle_brands")
}

model Accident {
  id              String        @id @default(uuid())
  accidentDate    DateTime      @map("accident_date") @db.Date
  accidentTime    String        @map("accident_time") @db.VarChar(5)
  governorateId   Int           @map("governorate_id")
  governorate     Governorate   @relation(fields: [governorateId], references: [id])
  cityId          Int?          @map("city_id")
  city            City?         @relation(fields: [cityId], references: [id])
  route           String?       @db.VarChar(300)
  kilometrePoint  Decimal?      @map("kilometre_point") @db.Decimal(10, 2)
  causeId         Int           @map("cause_id")
  cause           AccidentCause @relation(fields: [causeId], references: [id])
  vehicleBrand1Id Int?          @map("vehicle_brand1_id")
  vehicleBrand1   VehicleBrand? @relation("Brand1", fields: [vehicleBrand1Id], references: [id])
  vehicleBrand2Id Int?          @map("vehicle_brand2_id")
  vehicleBrand2   VehicleBrand? @relation("Brand2", fields: [vehicleBrand2Id], references: [id])
  deathsCount     Int           @default(0) @map("deaths_count")
  injuriesCount   Int           @default(0) @map("injuries_count")
  description     String?       @db.Text
  metadata        Json?
  importJobId     String?       @map("import_job_id")
  importJob       ImportJob?    @relation(fields: [importJobId], references: [id])
  createdById     String?       @map("created_by_id")
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  @@index([accidentDate])
  @@index([governorateId])
  @@index([causeId])
  @@index([createdAt])
  @@index([accidentDate, accidentTime, route, kilometrePoint], name: "idx_dedup")
  @@map("accidents")
}

model ImportJob {
  id          String          @id @default(uuid())
  fileName    String          @map("file_name") @db.VarChar(500)
  totalRows   Int             @default(0) @map("total_rows")
  validRows   Int             @default(0) @map("valid_rows")
  invalidRows Int             @default(0) @map("invalid_rows")
  status      ImportJobStatus @default(PENDING)
  createdById String          @map("created_by_id")
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now()) @map("created_at")

  rows      ImportJobRow[]
  accidents Accident[]

  @@map("import_jobs")
}

model ImportJobRow {
  id          String    @id @default(uuid())
  importJobId String    @map("import_job_id")
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber   Int       @map("row_number")
  rawData     Json      @map("raw_data")
  isValid     Boolean   @default(false) @map("is_valid")
  errors      Json?
  accidentId  String?   @map("accident_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("import_job_rows")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
